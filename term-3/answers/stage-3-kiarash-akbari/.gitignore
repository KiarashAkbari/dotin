# Virtual environments
venv/
.venv/
env/
ENV/

# Python junk
__pycache__/
*.pyc
.env
*.egg-info/

# The Kaggle competition file is never in Git: it is licensed per-user and the
# delivery guide forbids raw data in history. Accepting the rules happens on the
# student's account, so the file is placed here by hand.
data/raw/*
!data/raw/.gitkeep

# Rejected rows carry applicant values verbatim; a quarantine file in history would
# undo the whole "no raw data in Git" rule
data/quarantine/

# Model artifacts and regenerated outputs
data/curated/*
!data/curated/.gitkeep
*.joblib
data/run_manifest*.json

.ipynb_checkpoints/
solution.before-fix.ipynb

# The local copy of the source config. It holds paths on the student's machine and
# nothing worth reviewing, while config/credit.example.toml is the tracked contract -
# and the example says "untracked", so this makes that sentence true.
config/credit.toml

# Jupyter writes these beside an open notebook; a stray copy in Git would look like
# a second, older delivery
*checkpoint.ipynb
.ipynb_checkpoints/

# tool caches and OS junk
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.pyo
.DS_Store
