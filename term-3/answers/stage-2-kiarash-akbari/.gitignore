# Virtual environments
venv/
.venv/
env/
ENV/

# Python junk
__pycache__/
*.pyc
.env
*.egg-info/

# Raw data never goes to Git
data/raw/*
!data/raw/.gitkeep

# Pipeline outputs: regenerated by the factory, not versioned
data/quarantine/*
!data/quarantine/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/run_manifest.json
data/run_manifest*.json

.ipynb_checkpoints/
solution.before-fix.ipynb