  "method": "3 warmups per version; 15 measured runs per version; alternating order; db_benchmark.consume including hashing",
  "original_sql": "-- Denominator: observed delivered orders; calendar-day delay; purchase month.\nSELECT date_trunc('month', d.order_purchase_timestamp)::date AS purchase_month,\n       c.customer_state, COUNT(*) AS delivered_orders,\n       COUNT(*) FILTER (WHERE olist.delivery_delay_days(\n           d.order_delivered_customer_date, d.order_estimated_delivery_date) > 0) AS late_orders,\n       AVG((olist.delivery_delay_days(d.order_delivered_customer_date,\n           d.order_estimated_delivery_date) > 0)::integer)::numeric AS late_ratio\nFROM olist.v_delivered_orders AS d\nJOIN olist.customers AS c ON c.customer_id = d.customer_id\nGROUP BY 1, 2 ORDER BY 1, 2;\n",
  "candidate_sql": "\nWITH grouped AS MATERIALIZED (\n    SELECT\n        date_trunc(\n            'month', d.order_purchase_timestamp\n        )::date AS purchase_month,\n        c.customer_state,\n        COUNT(*) AS delivered_orders,\n        COUNT(*) FILTER (\n            WHERE olist.delivery_delay_days(\n                d.order_delivered_customer_date,\n                d.order_estimated_delivery_date\n            ) > 0\n        ) AS late_orders,\n        AVG((\n            olist.delivery_delay_days(\n                d.order_delivered_customer_date,\n                d.order_estimated_delivery_date\n            ) > 0\n        )::integer)::numeric AS late_ratio\n    FROM olist.v_delivered_orders AS d\n    JOIN olist.customers AS c\n        ON c.customer_id = d.customer_id\n    GROUP BY 1, 2\n)\nSELECT\n    purchase_month,\n    customer_state,\n    delivered_orders,\n    late_orders,\n    late_ratio\nFROM grouped\nORDER BY 1, 2\n",
